# Copy to .env for local (non-Docker) runs, then: set -a; source .env; set +a; ./mvnw spring-boot:run
# No real secrets here.

# Required: HMAC key for JWTs, at least 32 characters. Generate one with: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=7d

DB_URL=jdbc:postgresql://localhost:15433/cod_settlement
DB_USERNAME=cod
DB_PASSWORD=cod
DB_POOL_SIZE=10

# "demo" seeds deterministic demo data on startup (users: ops / atlas / medina, password demo-pass-123)
SPRING_PROFILES_ACTIVE=demo

UPLOAD_MAX_FILE_SIZE=5MB
LOG_LEVEL=INFO
PORT=18080

# docker compose host ports (defaults avoid 8080/5432/3000/3100, often used by other local stacks)
APP_PORT=18080
DB_PORT=15433
WEB_PORT=3200
